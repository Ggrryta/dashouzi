services:
  gateway:
    build: .
    entrypoint: ["/app/gateway"]
    command: ["-config", "config/gateway.yaml"]
    container_name: im_gateway
    ports: ["8080:8080"]
    depends_on: { mysql: { condition: service_healthy }, redis: { condition: service_healthy } }
    restart: unless-stopped

  node-1:
    build: .
    entrypoint: ["/app/imnode"]
    command: ["-config", "config/node.yaml"]
    container_name: im_node_1
    ports: ["8081:8081"]
    environment: { NODE_ID: node-1, SERVER_PORT: "8081" }
    depends_on: { mysql: { condition: service_healthy }, redis: { condition: service_healthy } }
    restart: unless-stopped

  node-2:
    build: .
    entrypoint: ["/app/imnode"]
    command: ["-config", "config/node.yaml"]
    container_name: im_node_2
    ports: ["8082:8082"]
    environment: { NODE_ID: node-2, SERVER_PORT: "8082" }
    depends_on: { mysql: { condition: service_healthy }, redis: { condition: service_healthy } }
    restart: unless-stopped

  node-3:
    build: .
    entrypoint: ["/app/imnode"]
    command: ["-config", "config/node.yaml"]
    container_name: im_node_3
    ports: ["8083:8083"]
    environment: { NODE_ID: node-3, SERVER_PORT: "8083" }
    depends_on: { mysql: { condition: service_healthy }, redis: { condition: service_healthy } }
    restart: unless-stopped

  mysql:
    image: mysql:8.0
    container_name: im_mysql
    environment: { MYSQL_ROOT_PASSWORD: root123, MYSQL_DATABASE: im, MYSQL_USER: im, MYSQL_PASSWORD: im123 }
    ports: ["3309:3306"]
    volumes: [im_mysql_data:/var/lib/mysql, ./scripts/init.sql:/docker-entrypoint-initdb.d/init.sql]
    healthcheck: { test: ["CMD","mysqladmin","ping","-h","localhost","-u","im","-pim123"], interval: 10s, timeout: 10s, retries: 10 }
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: im_redis
    ports: ["6381:6379"]
    healthcheck: { test: ["CMD","redis-cli","ping"], interval: 5s, timeout: 5s, retries: 5 }
    restart: unless-stopped

  kafka:
    image: apache/kafka:latest
    container_name: im_kafka
    ports: ["9093:9092"]
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT"
      KAFKA_ADVERTISED_LISTENERS: "PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9093"
      KAFKA_LISTENERS: "CONTROLLER://:9094,PLAINTEXT://:9092,PLAINTEXT_HOST://:9093"
      KAFKA_PROCESS_ROLES: "broker,controller"
      KAFKA_CONTROLLER_QUORUM_VOTERS: "1@localhost:9094"
      KAFKA_CONTROLLER_LISTENER_NAMES: "CONTROLLER"
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
    restart: unless-stopped

volumes:
  im_mysql_data:
