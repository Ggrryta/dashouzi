# 后端 Dockerfile（Go）
FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o /coach-server cmd/server/main.go

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /coach-server /coach-server
EXPOSE 8080
CMD ["/coach-server"]
