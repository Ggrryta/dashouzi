# MySQL Coach 开发环境配置
# 复制此文件为 .env 并填入真实值

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=coach
DB_PASSWORD=coach123
DB_NAME=mysql_coach
DB_SSLMODE=disable

# ===== LLM =====
# 接口隔离：支持 OpenAI 协议的任意 provider
LLM_PROVIDER=openai          # openai / zhipu / qwen / custom
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ===== 服务 =====
SERVER_PORT=8080
GIN_MODE=debug                # debug / release

# ===== 前端 =====
FRONTEND_URL=http://localhost:3000

# ===== GitHub OAuth（MVP 后做）=====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
